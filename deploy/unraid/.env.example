# Copy this file to .env in the same directory before starting the Compose stack.
EMBY_INSIGHTS_PORT=8081

# Use a long, unique value. Changing it after the first start invalidates the local database.
POSTGRES_PASSWORD=replace-with-a-long-unique-password

# This is the Unraid host running Emby; include the /emby path.
EMBY_BASE_URL=http://10.0.0.2:8096/emby
EMBY_DEVICE_ID=emby-insights-0fc5b8ab-46c2-45e5-a7bb-00f79a0f6767

# Create this in Emby: Dashboard → Advanced → Security → API Keys.
EMBY_ADMIN_API_KEY=replace-with-an-Emby-admin-api-key

# Keep false while accessing http://biggi:8081 directly. Change to true once a HTTPS reverse proxy is used.
COOKIE_SECURE=false

# Optional: direct Radarr/Sonarr release calendars. TMDB enables regional dates.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
TMDB_API_KEY=
COMINGSOON_REGION=DE
COMINGSOON_DAYS_AHEAD=28

# Optional: comma-separated IDs of the Emby libraries to source
# "Neu für dich" from. Leave empty to disable that Home card.
EMBY_NEW_FOR_YOU_LIBRARY_IDS=

# Optional: comma-separated IDs of the Emby libraries "Gesehene Filme"/
# "Gesehene Serien" on the Statistics page are scoped to. Leave empty to
# disable both lists.
EMBY_WATCHED_LIBRARY_IDS=

# Optional: Jellyseerr/Overseerr URL and API key (Settings → General).
# Leave both empty to disable the Requests Home card.
SEERR_URL=
SEERR_API_KEY=
