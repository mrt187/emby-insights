# Copy this file to .env in the same directory before starting the Compose stack.
EMBY_INSIGHTS_PORT=8081

# Use a long, unique value. Changing it after the first start invalidates the local database.
POSTGRES_PASSWORD=replace-with-a-long-unique-password

# This is the Unraid host running Emby; include the /emby path.
EMBY_BASE_URL=http://10.0.0.2:8096/emby
EMBY_DEVICE_ID=emby-insights-0fc5b8ab-46c2-45e5-a7bb-00f79a0f6767

# Create this in Emby: Dashboard → Advanced → Security → API Keys.
EMBY_ADMIN_API_KEY=replace-with-an-Emby-admin-api-key

# Keep false while accessing http://biggi:8081 directly. Change to true once a HTTPS reverse proxy is used.
COOKIE_SECURE=false
