# Mandatory: choose a long, unique value before the first start.
POSTGRES_PASSWORD=change-me

# Optional: only change this if port 8080 is already in use inside the container.
LISTEN_ADDRESS=:8080

# Emby API base URL, including /emby. This never reaches the browser.
EMBY_BASE_URL=http://emby:8096/emby
# A unique, stable identifier for this dashboard installation.
EMBY_DEVICE_ID=replace-with-a-unique-stable-device-id
# Keep true behind a HTTPS reverse proxy. Set false only for local HTTP development.
COOKIE_SECURE=true
EMBY_ADMIN_API_KEY=replace-with-an-Emby-admin-api-key
