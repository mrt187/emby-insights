EMBY_INSIGHTS_IMAGE=ghcr.io/mrt187/emby-insights:latest
EMBY_INSIGHTS_PORT=8081
LISTEN_ADDRESS=:8080

POSTGRES_PASSWORD=change-me
APP_ENCRYPTION_KEY=

EMBY_BASE_URL=http://your-emby-host:8096/emby
EMBY_ADMIN_API_KEY=replace-with-an-Emby-admin-api-key

# Keep this true if you access Emby Insights via HTTPS (e.g. behind a
# reverse proxy). Set it to false only if you access it over plain HTTP
# (no TLS) — otherwise the browser silently drops the session cookie and
# the UI will look logged out / show no data.
COOKIE_SECURE=true
#TRUSTED_PROXIES=

# Web Push (VAPID) keypair for browser push notifications. Generate once and
# keep it stable — rotating it invalidates every existing browser
# subscription. Generate with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY is not a secret; VAPID_PRIVATE_KEY must stay server-side.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# How often the background poller checks subscribed users for new content to
# push-notify about. Accepts any Go duration (e.g. 15m, 30m, 1h).
#PUSH_POLL_INTERVAL=20m
