# Mandatory: choose a long, unique value before the first start.
POSTGRES_PASSWORD=change-me

# Optional: only change this if port 8080 is already in use inside the container.
LISTEN_ADDRESS=:8080

# Emby API base URL, including /emby. This never reaches the browser.
EMBY_BASE_URL=http://emby:8096/emby
# Keep true behind a HTTPS reverse proxy. Set false only for local HTTP development.
COOKIE_SECURE=true
EMBY_ADMIN_API_KEY=replace-with-an-Emby-admin-api-key

# Encrypts Seerr/Radarr/Sonarr/TMDB API keys stored in Postgres. Generate
# once with `openssl rand -base64 32` and keep it stable — losing it makes
# any saved keys unreadable.
APP_ENCRYPTION_KEY=

# Optional: direct Radarr/Sonarr release calendars. TMDB enables regional dates.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
TMDB_API_KEY=
COMINGSOON_REGION=DE
COMINGSOON_DAYS_AHEAD=28

# Optional: comma-separated Emby library IDs to source "Neu für dich" from.
# Leave empty to disable that Home card.
EMBY_NEW_FOR_YOU_LIBRARY_IDS=

# Optional: comma-separated Emby library IDs "Gesehene Filme"/"Gesehene
# Serien" on the Statistics page are scoped to. Leave empty to disable
# both lists.
EMBY_WATCHED_LIBRARY_IDS=

# Optional: leave both empty to disable the Requests Home card.
SEERR_URL=
SEERR_API_KEY=

# Optional: your own Emby user ID, so the app recognizes you as the admin
# for the internal chat (Chats page shows every user's thread instead of a
# single conversation). Leave empty to disable chat entirely. Find your ID
# in the response of GET /api/me while logged in as yourself.
ADMIN_EMBY_USER_ID=
