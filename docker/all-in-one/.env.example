# Copy this file to .env in the same directory before starting the Compose stack.
EMBY_INSIGHTS_PORT=8081

# Use a long, unique value. Changing it after the first start invalidates the local database.
POSTGRES_PASSWORD=change-me

# Optional: only change this if port 8080 is already in use inside the container.
LISTEN_ADDRESS=:8080

# This is the host running Emby; include the /emby path.
EMBY_BASE_URL=http://your-emby-host:8096/emby

# Create this in Emby: Dashboard → Advanced → Security → API Keys.
EMBY_ADMIN_API_KEY=replace-with-an-Emby-admin-api-key

# Keep false only for the first direct HTTP test at this port; set it to true
# once a HTTPS reverse proxy is in front of the app.
COOKIE_SECURE=true

# Encrypts Seerr/Radarr/Sonarr/TMDB API keys stored in Postgres. Generate
# once with `openssl rand -base64 32` and keep it stable — losing it makes
# any saved keys unreadable. Everything else (which services are enabled,
# their addresses/keys, library selection, and who the admin is) is
# configured through the Verwaltung admin UI after your first login, not here.
APP_ENCRYPTION_KEY=
