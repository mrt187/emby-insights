# Local development only. Do not commit a real .env file.
LISTEN_ADDRESS=:8080
DATABASE_URL=postgres://emby_insights:change-me@localhost:5432/emby_insights?sslmode=disable
REDIS_URL=redis://localhost:6379/0
EMBY_BASE_URL=http://emby:8096/emby
# Set to false only for local HTTP development.
COOKIE_SECURE=false
EMBY_ADMIN_API_KEY=replace-with-an-Emby-admin-api-key

# Encrypts Seerr/Radarr/Sonarr/TMDB API keys stored in Postgres. Generate
# once with `openssl rand -base64 32` and keep it stable — losing it makes
# any saved keys unreadable. Everything else (which services are enabled,
# their addresses/keys, library selection, and who the admin is) is
# configured through the Verwaltung admin UI after your first login, not here.
APP_ENCRYPTION_KEY=

# Web Push (VAPID) keypair for browser push notifications.
#
# The backend does not deliver notifications itself — it hands them to the
# browser's own push service (Apple for Safari/iOS, Google for Chrome,
# Mozilla for Firefox), and that service wants to know who is sending.
# This keypair is that proof of identity.
#
# Generate it exactly once. Run:
#
#     npx web-push generate-vapid-keys
#
# It prints two base64 strings — paste them into the two variables below.
# Without Node, call webpush.GenerateVAPIDKeys() from
# github.com/SherClockHolmes/webpush-go (the Go library this backend already
# uses to send pushes) in a throwaway main.go.
#
# Then never change them. The public key is stored inside every existing
# browser subscription, so a new keypair silently kills push for everyone
# until each user switches notifications off and on again.
#
# The public key is handed to every browser anyway (GET /api/push/public-key)
# and is not a secret; the private key must stay server-side.
# VAPID_SUBJECT is a contact address push service operators can reach you at,
# as mailto:you@example.com or https://your-domain.example.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# How often the background poller checks subscribed users for new content
# (new episodes, requests now available) to push-notify about. Accepts any
# Go duration (e.g. 15m, 30m, 1h).
PUSH_POLL_INTERVAL=20m
