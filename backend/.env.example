# Local development only. Do not commit a real .env file.
LISTEN_ADDRESS=:8080
DATABASE_URL=postgres://emby_insights:change-me@localhost:5432/emby_insights?sslmode=disable
REDIS_URL=redis://localhost:6379/0
EMBY_BASE_URL=http://emby:8096/emby
EMBY_DEVICE_ID=replace-with-a-unique-stable-device-id
# Set to false only for local HTTP development.
COOKIE_SECURE=false
EMBY_ADMIN_API_KEY=replace-with-an-Emby-admin-api-key

# Optional: direct Radarr/Sonarr release calendars. Leave both services empty
# to disable the Upcoming and "Im Kino" cards. TMDB enables regional dates.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
TMDB_API_KEY=
COMINGSOON_REGION=DE
COMINGSOON_DAYS_AHEAD=28

# Optional: comma-separated Emby library IDs to source "Neu für dich" from.
# Leave empty to disable that Home card.
EMBY_NEW_FOR_YOU_LIBRARY_IDS=

# Optional: comma-separated Emby library IDs "Gesehene Filme"/"Gesehene
# Serien" on the Statistics page are scoped to. Leave empty to disable
# both lists.
EMBY_WATCHED_LIBRARY_IDS=

# Optional: leave both empty to disable the Requests Home card.
SEERR_URL=
SEERR_API_KEY=
