# Local development only. Do not commit a real .env file.
LISTEN_ADDRESS=:8080
DATABASE_URL=postgres://emby_insights:change-me@localhost:5432/emby_insights?sslmode=disable
REDIS_URL=redis://localhost:6379/0
EMBY_BASE_URL=http://emby:8096/emby
EMBY_ADMIN_API_KEY=replace-with-an-Emby-admin-api-key

# false only for local HTTP development.
COOKIE_SECURE=false

# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Any Go duration, e.g. 15m, 30m, 1h.
PUSH_POLL_INTERVAL=20m

# Everything else — which services are enabled, their addresses and keys, and
# the library selection — is configured in the admin UI after the first login.
